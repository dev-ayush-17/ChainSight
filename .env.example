# Neo4j Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# === LLM PROVIDERS ===
# HuggingFace (Primary — Free Tier)
# Get your free API key at: https://huggingface.co/settings/tokens
# Recommended free models:
#   - mistralai/Mistral-7B-Instruct-v0.3  (best quality, default)
#   - microsoft/Phi-3.5-mini-instruct      (faster, lighter)
#   - meta-llama/Llama-3.2-3B-Instruct    (fast, efficient)
HF_API_KEY=your_huggingface_token_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Google Gemini (Optional Fallback)
# Free tier: 15 RPM / 1M TPM via https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq (Optional Fallback — Higher RPM Free Tier)
# https://console.groq.com/keys
GROQ_API_KEY=

# News API (Optional — enhances news ingestion)
# https://newsapi.org/register
NEWSAPI_KEY=

# Application Settings
RANDOM_SEED=42
LOG_LEVEL=INFO
